# Copy to cloud/aws.env (git-ignored) and fill in your own account's values.
# launch.sh and sync.sh read this file; nothing account-specific is kept in the repository.
AWS_PROFILE=your-aws-cli-profile
AWS_REGION=eu-north-1                       # region with the subnets below
GP_KEY_NAME=your-ec2-key-pair-name
GP_KEY_FILE=$HOME/.ssh/your-key.pem         # private key of that key pair
GP_SECURITY_GROUP=sg-xxxxxxxxxxxxxxxxx      # must allow SSH from your address
GP_SUBNET_A=subnet-xxxxxxxxxxxxxxxxx        # three subnets in different availability zones
GP_SUBNET_B=subnet-xxxxxxxxxxxxxxxxx
GP_SUBNET_C=subnet-xxxxxxxxxxxxxxxxx
GP_AMI=ami-xxxxxxxxxxxxxxxxx                # Ubuntu 24.04 arm64 (Graviton) for that region
